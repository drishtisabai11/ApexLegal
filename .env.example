# Frontend Environment Variables
VITE_API_BASE_URL=/api

# Server Environment Variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/apex_legal
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

# Persistent File Storage Provider Configuration
# Supported options: 'local' (default disk storage under /uploads), 's3', 'cloudinary', 'supabase'
STORAGE_PROVIDER=local

# AWS S3 Provider Credentials (Required when STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Cloudinary Credentials (Required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

